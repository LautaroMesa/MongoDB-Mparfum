            "locale": "simple"
          }
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "cliente._id": {
              "$numberInt": "1"
            },
            "fecha": {
              "$numberInt": "-1"
            }
          },
          "name": "ix_cliente_fecha",
          "collation": {
            "locale": "simple"
          }
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "fecha": {
              "$numberInt": "1"
            },
            "estado": {
              "$numberInt": "1"
            }
          },
          "name": "ix_fecha_estado",
          "collation": {
            "locale": "simple"
          }
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "estado": {
              "$numberInt": "1"
            },
            "deposito": {
              "$numberInt": "1"
            },
            "fecha": {
              "$numberInt": "1"
            }
          },
          "name": "ix_estado_deposito_fecha",
          "collation": {
            "locale": "simple"
          }
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "envio.tracking": {
              "$numberInt": "1"
            }
          },
          "name": "ux_tracking",
          "unique": true,
          "partialFilterExpression": {
            "envio.tracking": {
              "$exists": true
            }
          },
          "collation": {
            "locale": "simple"
          }
        },
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "items.productoId": {
              "$numberInt": "1"
            }
          },
          "name": "ix_items_producto",
          "collation": {
            "locale": "simple"
          }
        }
      ]
    },
    {
      "nombre": "categorias",
      "tipo": "collection",
      "documentos": {
        "$numberInt": "26"
      },
      "opciones": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "_id",
              "nombre",
              "nivel",
              "ruta"
            ],
            "properties": {
              "_id": {
                "bsonType": "string"
              },
              "nombre": {
                "bsonType": "string"
              },
              "padre": {
                "bsonType": [
                  "string",
                  "null"
                ]
              },
              "ruta": {
                "bsonType": "array",
                "items": {
                  "bsonType": "string"
                }
              },
              "nivel": {
                "bsonType": "int",
                "minimum": {
                  "$numberInt": "1"
                },
                "maximum": {
                  "$numberInt": "3"
                }
              },
              "orden": {
                "bsonType": "int"
              }
            }
          }
        }
      },
      "indices": [
        {
          "v": {
            "$numberInt": "2"
          },
          "key": {
            "padre": {
              "$numberInt": "1"
            },
            "orden": {
              "$numberInt": "1"
            }
          },
          "name": "ix_padre_orden",
          "collation": {
            "locale": "simple"
          }
        }
      ]
    }
  ],
  "vistas": [
    {
      "nombre": "v_catalogo_publico",
      "viewOn": "productos",
      "pipeline": [
        {
          "$match": {
            "activo": true
          }
        },
        {
          "$project": {
            "nombre": {
              "$numberInt": "1"
            },
            "tipo": {
              "$numberInt": "1"
            },
            "genero": {
              "$numberInt": "1"
            },
            "marca": "$marca.nombre",
            "categoria": "$categoria._id",
            "descripcion": {
              "$numberInt": "1"
            },
            "atributos": {
              "$numberInt": "1"
            },
            "rating": {
              "$numberInt": "1"
            },
            "variantes": {
              "$map": {
                "input": "$variantes",
                "in": {
                  "sku": "$$this.sku",
                  "presentacion": "$$this.presentacion",
                  "tono": "$$this.tono",
                  "precio": "$$this.precio",
                  "disponible": {
                    "$gt": [
                      {
                        "$sum": "$$this.stock.cantidad"
                      },
                      {
                        "$numberInt": "0"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "nombre": "v_ventas_diarias",
      "viewOn": "pedidos",
      "pipeline": [
        {
          "$match": {
            "estado": {
              "$ne": "cancelado"
            }
          }
        },
        {
          "$group": {
            "_id": {
              "dia": {
                "$dateToString": {
                  "format": "%Y-%m-%d",
                  "date": "$fecha",
                  "timezone": "America/Argentina/Mendoza"
                }
              },
              "canal": "$canal",
              "deposito": "$deposito"
            },
            "pedidos": {
              "$sum": {
                "$numberInt": "1"
              }
            },
            "facturacion": {
              "$sum": "$total"
            },
            "descuentos": {
              "$sum": "$descuento"
            }
          }
        },
        {
          "$project": {
            "_id": {
              "$numberInt": "0"
            },
            "dia": "$_id.dia",
            "canal": "$_id.canal",
            "deposito": "$_id.deposito",
            "pedidos": {
              "$numberInt": "1"
            },
            "facturacion": {
              "$numberInt": "1"
            },
            "descuentos": {
              "$numberInt": "1"
            }
          }
        }
      ]
    },
    {
      "nombre": "v_stock_por_deposito",
      "viewOn": "productos",
      "pipeline": [
        {
          "$match": {
            "activo": true
          }
        },
        {
          "$unwind": "$variantes"
        },
        {
          "$unwind": "$variantes.stock"
        },
        {
          "$project": {
            "_id": {
              "$numberInt": "0"
            },
            "deposito": "$variantes.stock.deposito",
            "sku": "$variantes.sku",
            "producto": "$nombre",
            "marca": "$marca.nombre",
            "presentacion": "$variantes.presentacion",
            "cantidad": "$variantes.stock.cantidad"
          }
        }
      ]
    }
  ]
}